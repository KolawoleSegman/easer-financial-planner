generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PREMIUM
  ADMIN
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  name              String?
  currency          String           @default("NGN")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  plan              UserPlan         @default(FREE)
  emailVerifiedAt   DateTime?
  verificationToken String?          @unique
  resetTokenHash    String?          @unique
  resetExpiresAt    DateTime?
  deletedAt         DateTime?
  expenses          Expense[]
  goals             Goal[]
  plans             FinancialPlan[]
  sessions          Session[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]
  paymentEvents     PaymentEvent[]

  @@index([plan])
  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FinancialPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  income    Int
  savings   Int      @default(0)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Int      @default(0)
  essential Boolean  @default(true)
  month     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  name      String
  target    Int
  saved     Int      @default(0)
  months    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                       String    @id @default(cuid())
  userId                   String
  provider                 String    @default("paystack")
  providerCustomerCode     String?
  providerSubscriptionCode String?
  providerEmailToken       String?
  status                   String    @default("inactive")
  planCode                 String?
  amount                   Int?
  currency                 String    @default("NGN")
  reference                String?   @unique
  currentPeriodEnd         DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([reference])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventId    String?  @unique
  reference  String   @unique
  eventType  String
  amount     Int?
  currency   String?
  status     String
  rawSummary Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
